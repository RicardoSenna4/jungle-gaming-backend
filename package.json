{
  "name": "jungle-distributed-wagering-processor",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:bun": "bun run dist/main.js",
    "test": "bun run test:all",
    "test:unit": "bun run scripts/run-required-tests.ts unit",
    "test:node": "jest --runInBand",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.ts\" \".github/workflows/*.yml\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.ts\" \".github/workflows/*.yml\"",
    "db:migrate": "mikro-orm migration:up --config src/infrastructure/database/mikro-orm.config.ts",
    "db:rollback": "mikro-orm migration:down --config src/infrastructure/database/mikro-orm.config.ts",
    "db:migration:check": "mikro-orm migration:pending --config src/infrastructure/database/mikro-orm.config.ts",
    "ci:services": "docker compose up -d postgres localstack && bun run db:migrate",
    "test:integration": "bun run test:integration:postgres && bun run test:integration:sqs",
    "test:integration:postgres": "bun run scripts/run-required-tests.ts postgres",
    "test:integration:sqs": "bun run scripts/run-required-tests.ts sqs",
    "test:sqs:real": "bun run test:integration:sqs",
    "test:concurrency": "bun run scripts/run-required-tests.ts concurrency",
    "test:recovery": "bun run scripts/run-required-tests.ts recovery",
    "test:all": "bun run scripts/run-required-tests.ts all",
    "smoke:compose": "bun run scripts/smoke-compose.ts"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.750.0",
    "@mikro-orm/core": "^6.4.5",
    "@mikro-orm/migrations": "^6.4.5",
    "@mikro-orm/nestjs": "^6.1.1",
    "@mikro-orm/postgresql": "^6.4.5",
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "decimal.js": "^10.4.3",
    "dotenv": "^16.4.7",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@mikro-orm/cli": "^6.6.18",
    "@nestjs/cli": "^10.4.9",
    "@nestjs/testing": "^10.4.15",
    "@types/bun": "latest",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "ajv": "^8.13.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0"
  },
  "packageManager": "bun@1.1.38",
  "engines": {
    "node": ">=22",
    "bun": ">=1.1.0"
  }
}
