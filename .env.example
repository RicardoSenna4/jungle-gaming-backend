NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/jungle
DB_HOST=localhost
DB_PORT=5432
DB_NAME=jungle
DB_USER=postgres
DB_PASSWORD=postgres
AWS_REGION=us-east-1
SQS_ENDPOINT=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_QUEUE_URL=http://localhost:4566/000000000000/wager-transactions.fifo
SQS_DLQ_QUEUE_URL=http://localhost:4566/000000000000/wager-transactions-dlq.fifo
SQS_EVENTS_QUEUE_URL=http://localhost:4566/000000000000/wager-events.fifo
SQS_VISIBILITY_TIMEOUT=30
SQS_MAX_RECEIVE_COUNT=3
ENABLE_SQS_CONSUMER=false
ENABLE_OUTBOX_PUBLISHER=false
ENABLE_PENDING_REFERENCE_WORKER=true
OUTBOX_INTERVAL_MS=500
OUTBOX_BATCH_SIZE=20
OUTBOX_LEASE_SECONDS=60
AUTH_MODE=challenge
OIDC_ISSUER_URL=
OIDC_AUDIENCE=
OIDC_JWKS_URI=
OIDC_PROVIDER_ID_CLAIM=providerId
OIDC_JWKS_CACHE_TTL_SECONDS=300
OIDC_HTTP_TIMEOUT_MS=3000
OIDC_CLOCK_SKEW_SECONDS=30
# Administrative JWT policy: exact values in verified top-level claims.
OIDC_ROLES_CLAIM=roles
OIDC_PERMISSIONS_CLAIM=scope
OIDC_OPERATOR_ROLES=operator
OIDC_ADMIN_ROLES=admin
OIDC_QUARANTINE_READ_PERMISSION=quarantine:read
OIDC_QUARANTINE_RESOLVE_PERMISSION=quarantine:resolve
OIDC_METRICS_READ_PERMISSION=metrics:read
# auto: OIDC authenticated; challenge dev/test public; challenge production disabled.
METRICS_ACCESS=auto
# Public HTTPS origins accepted for discovery JWKS on a separate origin (CSV).
OIDC_JWKS_ALLOWED_ORIGINS=
OIDC_JWKS_REFRESH_COOLDOWN_MS=1000
# Local tests/development only; ignored in production.
OIDC_ALLOW_LOOPBACK_HTTP=false
OIDC_QUARANTINE_REDRIVE_PERMISSION=quarantine:redrive
